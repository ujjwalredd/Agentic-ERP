# Copy to .env and fill in. `cp .env.example .env`

# --- LLM ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Set to true to run all agents with deterministic mock responses (no API spend).
USE_MOCK_LLM=false

# --- security ----------------------------------------------------------
# Browser origins allowed to call the API (comma-separated). Use the frontend URL.
CORS_ORIGINS=http://localhost:3000

# --- per-user auth (recommended) --------------------------------------
# Set JWT_SECRET to a long random string to enable per-user login. When set,
# write endpoints require a JWT from POST /auth/login and the audit log records
# the real user's email. A demo controller is seeded on first boot:
#   email = SEED_USER_EMAIL, password = SEED_USER_PASSWORD
# Leave JWT_SECRET EMPTY to fall back to the legacy shared-token / open-dev mode.
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
SEED_USER_EMAIL=controller@demo
SEED_USER_PASSWORD=demo1234

# --- legacy shared token (fallback, used only when JWT_SECRET is empty) -
# Bearer token required on state-changing endpoints. Leave EMPTY for open local
# dev; set a strong value for any shared/deployed environment.
API_TOKEN=
# Identity stamped into the audit log when the shared token is used.
API_USER=controller@demo
