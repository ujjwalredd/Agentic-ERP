# Copy to .env and fill in. `cp .env.example .env`

# --- LLM ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Set to true to run all agents with deterministic mock responses (no API spend).
USE_MOCK_LLM=false

# --- security ----------------------------------------------------------
# Browser origins allowed to call the API (comma-separated). Use the frontend URL.
CORS_ORIGINS=http://localhost:3000
# Bearer token required on state-changing endpoints. Leave EMPTY for open local
# dev; set a strong value for any shared/deployed environment.
API_TOKEN=
# Identity stamped into the immutable audit log when a token is presented.
API_USER=controller@demo

# Frontend: must match API_TOKEN above so the browser can authenticate.
NEXT_PUBLIC_API_TOKEN=
